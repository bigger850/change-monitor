# 备案通过 + Let's Encrypt 签发证书后启用：
#   certbot certonly --nginx -d bigger.ink -d www.bigger.ink -d api.bigger.ink
#   把本文件复制为 nginx.conf 并替换 compose 挂载，然后 docker compose restart nginx
# 证书路径按实际域名调整。

upstream watch_backend {
    server app:8080;
    keepalive 32;
}

server {
    listen 80;
    server_name bigger.ink www.bigger.ink api.bigger.ink;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name bigger.ink www.bigger.ink api.bigger.ink;

    ssl_certificate     /etc/letsencrypt/live/bigger.ink/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bigger.ink/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 2m;
    gzip on;
    gzip_types text/css application/javascript application/json text/event-stream;

    location /api/v1/ {
        rewrite ^/api/v1/(.*)$ /$1 break;
        proxy_pass http://watch_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 300s;
    }

    location = /api/v1/stream/events {
        rewrite ^/api/v1/(.*)$ /$1 break;
        proxy_pass http://watch_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        chunked_transfer_encoding on;
    }

    location / { try_files $uri $uri/ /index.html; }
    location ~* \.(js|css|png|svg|ico|woff2?)$ { expires 7d; }
    location = /healthz { add_header Content-Type text/plain; return 200 "ok\n"; }
}
