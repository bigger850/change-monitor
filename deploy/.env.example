# 复制为 deploy/.env 后按实际修改；.env 不要提交到版本库
MYSQL_ROOT_PASSWORD=replace-with-strong-db-password
WATCH_JWT_SECRET=replace-with-random-string-at-least-32-bytes-long
WATCH_ADMIN_PASSWORD=replace-with-strong-admin-password
WATCH_CORS_ORIGIN=https://bigger.ink

# 邮件通道（留空则自动降级为仅记日志，不影响启动）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
